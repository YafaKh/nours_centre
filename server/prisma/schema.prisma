generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role is one of "STUDENT" | "TEACHER" | "ADMIN" (validated in application code —
// SQLite has no native enum type, so we keep this as a plain string column).
model User {
  id           String   @id @default(cuid())
  nameAr       String?
  nameEn       String?
  username     String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())

  student      Student?
  teacher      Teacher?
  sessions     Session[]
  ownedQuizzes Quiz[]
}

model Class {
  id       String      @id @default(cuid())
  name     String      @unique
  students Student[]
  quizzes  QuizClass[]
}

model Student {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId   String
  class     Class     @relation(fields: [classId], references: [id])
  studentId String    @unique
  email     String?
  attempts  Attempt[]
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email  String @unique
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// status is one of "DRAFT" | "PUBLISHED" (plain string column, same convention as User.role).
// Once any Attempt exists for a quiz, the whole quiz (shell + questions + options) is locked —
// see src/quiz/lock.ts — per FR-014.
model Quiz {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])
  title            String
  timeLimitMinutes Int      @default(20)
  openAt           DateTime
  closeAt          DateTime
  negativeMarking  Boolean  @default(false)
  penaltyFraction  Float    @default(0)
  status           String   @default("DRAFT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  classes   QuizClass[]
  questions Question[]
  attempts  Attempt[]
}

model QuizClass {
  quizId  String
  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  classId String
  class   Class  @relation(fields: [classId], references: [id])

  @@id([quizId, classId])
}

model Question {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order  Int
  text   String
  points Float

  options Option[]
  answers Answer[]

  @@unique([quizId, order])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  isCorrect  Boolean  @default(false)

  answers Answer[]

  @@unique([questionId, order])
}

// The table exists from Phase 2's migration on so the single-attempt unique constraint and
// the lock rule (FR-014) never need a later, riskier migration — see DECISIONS.md §2 #5.
model Attempt {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id])
  quizId         String
  quiz           Quiz      @relation(fields: [quizId], references: [id])
  startedAt      DateTime  @default(now())
  deadline       DateTime
  submittedAt    DateTime?
  submissionType String?
  score          Float?

  answers Answer[]

  @@unique([studentId, quizId])
}

// One row per question the student has picked an option for. Upserted on every autosave
// click (FR-023); unique per attempt+question so re-picking an answer replaces it rather
// than creating a second row.
model Answer {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  optionId   String
  option     Option   @relation(fields: [optionId], references: [id])
  answeredAt DateTime @updatedAt

  @@unique([attemptId, questionId])
}
